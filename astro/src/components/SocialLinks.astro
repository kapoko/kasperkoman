<script>
  document.querySelectorAll('.social-links').forEach((group) => {
    const target = group.querySelector('.link-target');
    group.querySelectorAll('a[data-social-name]').forEach((link) => {
      link.addEventListener('pointerenter', () => { target.textContent = link.dataset.socialName; target.classList.add('is-active'); });
      link.addEventListener('pointerleave', () => target.classList.remove('is-active'));
    });
  });
</script>
