---
import Base from '../layouts/Base.astro';
import { getGigs } from '../lib/content.js';
import Logo from '../components/Logo.astro';
import SocialLinks from '../components/SocialLinks.astro';
const gigs = await getGigs();
const today = new Date().toISOString().slice(0, 10);
const upcoming = gigs.filter((gig) => gig.meta.gig_date >= today).reverse();
const past = gigs.filter((gig) => gig.meta.gig_date < today);
const formatDate = (date) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short' }).format(new Date(`${date}T12:00:00`)).toUpperCase();
const eventSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': upcoming.map((gig) => ({
    '@type': 'MusicEvent',
    name: `${gig.title.rendered}${gig.meta.gig_venue ? ` at ${gig.meta.gig_venue}` : ''}`,
    startDate: gig.meta.gig_date,
    url: gig.meta.gig_url || undefined,
    location: {
      '@type': 'Place',
      name: gig.meta.gig_venue || gig.meta.gig_city,
      address: {
        '@type': 'PostalAddress',
        addressLocality: gig.meta.gig_city,
        addressCountry: gig.meta.gig_country_code,
      },
    },
    performer: { '@type': 'MusicGroup', name: 'Kasper Koman' },
  })),
}).replace(/</g, '\\u003c');
---
<Base title="Official Home" theme="light" preloadImage="/images/background_new.webp">
  {upcoming.length > 0 && <script type="application/ld+json" set:html={eventSchema}></script>}
  <section class="two-columns home-page">
    <div class="column image-column home-image"><picture><source srcset="/images/background_new.webp" type="image/webp" /><img class="page-image" src="/images/background_new.jpg" width="1440" height="1440" alt="" fetchpriority="high" decoding="async" /></picture><a class="mobile-logo" href="/" aria-label="Kasper Koman"><Logo /></a></div>
    <div class="column content-column"><div class="center-content"><div class="gig-list">
      {upcoming.length ? <h1>Tour Dates</h1><ul>{upcoming.map((gig) => <li>{gig.meta.gig_url ? <a href={gig.meta.gig_url} target="_blank">{formatDate(gig.meta.gig_date)} {gig.title.rendered}{gig.meta.gig_venue && ` @ ${gig.meta.gig_venue}`} <span class="separator">|</span> {gig.meta.gig_city}, {gig.meta.gig_country_code}</a> : <>{formatDate(gig.meta.gig_date)} {gig.title.rendered}{gig.meta.gig_venue && ` @ ${gig.meta.gig_venue}`} <span class="separator">|</span> {gig.meta.gig_city}, {gig.meta.gig_country_code}</>}</li>)}</ul> : <p>No upcoming gigs.</p>}
      {past.length > 0 && <><h2>Past</h2><ul class="past">{past.map((gig) => <li>{formatDate(gig.meta.gig_date)} {gig.title.rendered}{gig.meta.gig_venue && ` @ ${gig.meta.gig_venue}`} <span class="separator">|</span> {gig.meta.gig_city}, {gig.meta.gig_country_code}</li>)}</ul></>}
    </div><SocialLinks /></div></div>
  </section>
  <script>
    const updateGigLinkWrapping = () => {
      document.querySelectorAll('.gig-list a').forEach((link) => {
        link.classList.remove('is-wrapped');
        const lineHeight = Number.parseFloat(getComputedStyle(link).lineHeight);
        link.classList.toggle('is-wrapped', link.getBoundingClientRect().height > lineHeight + 1);
      });
    };

    updateGigLinkWrapping();
    document.fonts?.ready.then(updateGigLinkWrapping);

    let resizeTimer;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(updateGigLinkWrapping, 150);
    });
  </script>
</Base>
